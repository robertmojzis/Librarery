FUNCTION_BLOCK "FB_SoftStarter"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      Start : Bool;                    // Start command
      Stop : Bool;                     // Stop command; TRUE = stop
      Interlock : Bool;                // Permissive; TRUE = allowed to run
      MotorFeedback : Bool;            // Run feedback / auxiliary contact from soft starter
      FaultFeedback : Bool;            // Fault/trip relay from soft starter
      ResetFault : Bool;               // Rising edge acknowledges a latched fault
      FeedbackDelay : Time := T#5S;    // Max time to confirm feedback after MotorOn is set
   END_VAR

   VAR_OUTPUT
      MotorOn : Bool;                  // Command to soft starter enable input
      Running : Bool;                  // Confirmed running (MotorOn AND MotorFeedback)
      Fault : Bool;                    // Latched fault (trip or feedback timeout)
   END_VAR

   VAR
      FeedbackTimer : TON;             // Times out if MotorFeedback isn't confirmed
      ResetFaultEdge : R_TRIG;         // Edge detector for ResetFault
      RunLatch : Bool;                 // Internal start/stop latch
   END_VAR

BEGIN
   #ResetFaultEdge(CLK := #ResetFault);

   IF #Start AND NOT #Stop AND #Interlock AND NOT #Fault THEN
      #RunLatch := TRUE;
   ELSIF #Stop OR NOT #Interlock OR #Fault THEN
      #RunLatch := FALSE;
   END_IF;

   #MotorOn := #RunLatch;

   #FeedbackTimer(IN := #MotorOn AND NOT #MotorFeedback,
                  PT := #FeedbackDelay);

   #Running := #MotorOn AND #MotorFeedback;

   IF #FaultFeedback OR #FeedbackTimer.Q THEN
      #Fault := TRUE;
   ELSIF #ResetFaultEdge.Q THEN
      #Fault := FALSE;
   END_IF;

END_FUNCTION_BLOCK
